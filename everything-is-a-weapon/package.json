{
  "name": "everything-is-a-weapon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "build:gamemonetize": "tsc --noEmit && vite build --mode gamemonetize",
    "dev:crazygames": "vite --mode crazygames --port 5174",
    "dev:gamemonetize": "vite --mode gamemonetize --port 5175",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:physics": "esbuild scripts/physics-smoke.ts --bundle --platform=node --format=esm --log-level=warning | node --input-type=module"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
