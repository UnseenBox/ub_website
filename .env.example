# ─────────────────────────────────────────────────────────────
# UnseenBox — environment variables
# Copy to .env.local for local development.
# On Vercel, add them in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public canonical URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin authentication (server-only, never exposed to the browser)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ── Content storage
# Leave empty locally: content is saved to .data/content.json.
# On Vercel the filesystem is read-only, so connect an Upstash Redis database
# (Vercel Marketplace → Upstash → Redis). Either naming scheme works:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: namespace keys if several sites share one Redis database
CONTENT_KEY_PREFIX=unseenbox
