# ─────────────────────────────────────────────────────────────
# UnseenBox — environment variables
# Copy to .env.local for local development.
# On Vercel, add them in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public canonical URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin authentication (server-only, never exposed to the browser)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ── Content storage — Neon Postgres
# Leave empty locally: content is saved to .data/content.json.
# On Vercel the filesystem is read-only, so connect a Neon database
# (Vercel Marketplace → Neon, or neon.tech). DATABASE_URL is added for you.
# The site creates its tables and imports the seed content on first use.
DATABASE_URL=
# POSTGRES_URL and NEON_DATABASE_URL are accepted too.

# ── Image uploads (optional)
# Create a Blob store in Vercel → Storage and this is added automatically.
# Without it, the admin's upload button is disabled and images are linked by URL.
BLOB_READ_WRITE_TOKEN=

# Google Drive images need no key: share each file as "Anyone with the link"
# and paste the link into any image field in /admin.
