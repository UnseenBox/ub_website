{
  "name": "dig-and-discover",
  "private": true,
  "version": "0.1.0",
  "description": "Dig & Discover - a 2D rock mining and crystal discovery web game prototype",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames --outDir dist-crazygames",
    "build:website": "tsc --noEmit && vite build --mode website --outDir dist-website",
    "build:crazygames-basic": "tsc --noEmit && vite build --mode crazygames-basic --outDir dist-crazygames-basic",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/rye": "^5.3.0",
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
