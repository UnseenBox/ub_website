# Which ad network the build talks to:
#   dev         fake ad overlay, for testing the flow locally (default in `npm run dev`)
#   none        no ads, rewards are granted for free
#   crazygames  CrazyGames SDK v3 (upload the build to developer.crazygames.com)
#   h5          Google H5 Games Ads / AdSense for games (your own domain)
VITE_AD_PROVIDER=dev

# Only for VITE_AD_PROVIDER=h5: your AdSense publisher id.
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# Set to "on" while testing H5 ads so Google serves test ads.
VITE_ADSENSE_TEST=on

# Link put in shared results. Defaults to the page's own URL; set it when the
# game runs inside a portal iframe so shares point at the portal's game page.
# VITE_SHARE_URL=https://www.crazygames.com/game/chronodle
